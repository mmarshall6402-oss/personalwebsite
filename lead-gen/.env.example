# Required: Google Places API (New) key.
# Create one at https://console.cloud.google.com/ -> APIs & Services -> Credentials,
# and enable "Places API (New)" for the project.
GOOGLE_API_KEY=your_places_api_key_here

# Optional: enables best-effort email lookup and the "unlisted website" check.
# Create a Programmable Search Engine at https://programmablesearchengine.google.com/
# (set it to search the entire web) and a JSON API key at
# https://developers.google.com/custom-search/v1/introduction
# Free tier: 100 queries/day. Leave blank to skip enrichment (manual lookup only).
GOOGLE_CSE_ID=
GOOGLE_CSE_KEY=
